{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "paths": {
      "@overtone/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@overtone/core": [
        "../../packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
