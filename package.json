{
  "name": "overtone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable music streaming with pluggable sources",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/shared apps/server",
    "typecheck": "tsc -b packages/shared apps/server && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "tsc -b packages/shared && npm run dev -w @overtone/server",
    "start": "npm run start -w @overtone/server"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
