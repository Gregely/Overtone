# Copy to .env and fill in. Full reference: docs/PLAN.md §4.

# REQUIRED. 32 random bytes, base64. Encrypts stored provider secrets and signs stream tokens.
# Generate with:  openssl rand -base64 32
# Changing it makes previously saved API keys unreadable (you'd re-enter them).
OVERTONE_SECRET_KEY=

# Host folder with your music, mounted read-only into the container at /music.
MUSIC_DIR=/path/to/your/music

# Contact for the MusicBrainz User-Agent (email or URL). MusicBrainz asks for this.
OVERTONE_MB_CONTACT=you@example.com

# Host port (container always listens on 4800).
OVERTONE_PORT=4800

# Run the container as this user/group so it can write ./data (see `id -u`, `id -g`).
PUID=1000
PGID=1000

# Extra allowed CORS origins, comma separated. Capacitor origins are allowed by default.
OVERTONE_CORS_ORIGINS=

# Allow more than one user account.
OVERTONE_MULTI_USER=false

# Full library rescan interval in minutes (0 = only on start / on file changes).
OVERTONE_SCAN_INTERVAL_MINUTES=360

# Set to true when running behind a reverse proxy (Caddy, Traefik, nginx).
OVERTONE_TRUST_PROXY=false

# trace | debug | info | warn | error
OVERTONE_LOG_LEVEL=info
